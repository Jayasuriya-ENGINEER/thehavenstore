rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'havenweb26@gmail.com';
    }

    // Product and banner image URLs are shown on the public storefront.
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /site-banners/home-popup/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /site-banners/home-collections/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
